{
    "name": "super-rick/php-order-service",
    "description": "订单服务 PHP 实现(Slim 4 + PHPUnit)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/app.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    }
}
